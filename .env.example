# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database ---
# Leave empty locally: the app uses an embedded Postgres (PGlite) stored in .data/
# On Vercel: add a Neon Postgres database (Storage tab) and it sets DATABASE_URL for you.
DATABASE_URL=

# --- Auth ---
# Any long random string. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- AI (any OpenAI-compatible API; defaults target DeepSeek) ---
# Leave AI_API_KEY empty to run with the built-in mock AI (demo responses, no cost).
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
# "fast" = cheap model for bulk work, "smart" = better model for role-play / course generation.
# Both can be the same model. Check your provider's model list for exact names.
AI_MODEL_FAST=deepseek-flash
AI_MODEL_SMART=deepseek-flash
# DeepSeek-V4.1-Flash reasoning effort: low | high | max
AI_REASONING_EFFORT=max
# Set to false if your provider rejects response_format={"type":"json_object"}
AI_JSON_MODE=true
# Max AI calls per user per day (protects your API budget during demos)
AI_DAILY_LIMIT_PER_USER=200
